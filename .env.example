# Credenciais AWS (opcionais)
# Deixe as duas chaves vazias para usar a cadeia padrão do boto3:
# AWS_PROFILE/~/.aws (inclusive SSO após `aws sso login`) ou a role da
# instância/container. Preencha as duas só se precisar de chaves estáticas
# de um usuário IAM; preencher apenas uma gera erro.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=nome-do-perfil
AWS_REGION=us-east-1
S3_BUCKET_NAME=nome-do-seu-bucket-s3
# Tamanho máximo (MiB) de cada arquivo bruto lido do S3 pelo ETL (padrão 100)
MAX_RAW_FILE_MB=100

# Configurações do Banco de Dados (PostgreSQL no Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datalake_db
DB_USER=admin
DB_PASSWORD=troque_esta_senha
